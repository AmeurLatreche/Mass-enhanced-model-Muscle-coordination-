fprintf('Total number of coordinates (DOFs): %d\n', nCoordTotal);

% Store all coordinate names
allCoordNames = cell(nCoordTotal,1);
for i = 1:nCoordTotal
    allCoordNames{i} = char(coordSet.get(i-1).getName());
end

fprintf('\nList of all DOFs in the model:\n');
for i = 1:nCoordTotal
    fprintf('  %2d) %s\n', i, allCoordNames{i});
end

