% %% ==== MAIN: Solve Muscle Redundancy for multiple masses & windows ====
clear; clc; close all;
addpath(genpath('..\..\'));

%% Basic identifiers
subjectID    = 'sub03';
cadenceLabel = 'cadence140';     % used in output filenames

ExamplePath  = pwd;
DataPath     = fullfile(pwd,'WalkingData');

%% Folder where .mat files will be saved
saveRoot = 'E:\Reviewer 2';
if ~exist(saveRoot, 'dir')
    mkdir(saveRoot);
end

%% Input files
Misc.IKfile = {fullfile(DataPath, ...
    'IK_sub04_cad140_MGMTJ_2013_11_13_105812_015_3d_replace.mot')};
