% Adjust these lists if your model uses slightly different coordinate names

pelvisDOFs = { ...
    'pelvis_tx', 'pelvis_ty', 'pelvis_tz', ...
    'pelvis_tilt', 'pelvis_list', 'pelvis_rotation'};

