  'quad_fem_r',  0.103;
};

%% Build fullMassVec once from the model
import org.opensim.modeling.*
model      = Model(Misc.model_path);
nMusTotal  = model.getMuscles().getSize();
massMap    = containers.Map(realMassList(:,1), cell2mat(realMassList(:,2)));
fullMassVec = zeros(nMusTotal,1);

for i = 1:nMusTotal
    nm = char(model.getMuscles().get(i-1).getName());
    if massMap.isKey(nm)
        fullMassVec(i) = massMap(nm);
    end
end

% %% Mass scaling conditions & time windows
massScales  = [0.01, 1, 25, 70, 125];
timeWindows = {[0.44 1.08],[5.18 5.8],[10.06 10.71]};
winTags     = {'Win1','Win2','Win3'};

%% Mass scaling conditions & time windows
% massScales  = [1];
% timeWindows = {[1.61 2.24]};
% winTags     = {'Win1'};

%% Loop over windows and mass scales
for iw = 1:numel(timeWindows)

    time   = timeWindows{iw};
    winTag = winTags{iw};

    for im = 1:numel(massScales)

        scaleFactor = massScales(im);

        % Update muscle masses for this condition
        Misc.muscleMass = fullMassVec * scaleFactor;
        Misc.mass_value = scaleFactor;

        fprintf('\n=== %s, %s, mass=%g, window [%g %g] ===\n', ...
            subjectID, cadenceLabel, scaleFactor, time(1), time(2));

        fprintf('Per-muscle masses (kg) with scale ×%g:\n', scaleFactor);
        for k = 1:nMusTotal
            name = char(model.getMuscles().get(k-1).getName());
            fprintf('  %20s : %8.4f\n', name, Misc.muscleMass(k));
        end

        %% Run muscle redundancy solver
        [Results, DatStore] = solveMuscleRedundancy(time, Misc);

        %% Add muscle direction in ground for projected gravity
        trial = 1;
        DatStore = addMuscleUnitDirToDatStore(Misc.model_path, DatStore, trial);

        %% Choose diagnostic muscle for unit check in FormulateAndSolveMRS_1D
        Misc.diagMuscleName = 'rect_fem_r';

        %% Build filename and SAVE
        massStr = sprintf('%g', scaleFactor);

        if iw == 1
            baseName = sprintf('%s_%skg%s', subjectID, massStr, cadenceLabel);
        else
            baseName = sprintf('%s_%s_%skg%s', winTag, subjectID, massStr, cadenceLabel);
        end

        outFile = fullfile(saveRoot, [baseName '.mat']);

        save(outFile, 'Results', 'DatStore', 'Misc', ...
                      'time', 'scaleFactor', 'fullMassVec', ...
                      'realMassList', 'subjectID', 'cadenceLabel', '-v7.3');

        fprintf('→ Saved: %s\n', outFile);

    end
end

%% ===== Print number of DOFs in the model =====
coordSet = model.getCoordinateSet();
nCoordTotal = coordSet.getSize();

